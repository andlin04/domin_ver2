# domin: Settings > Public database > Sync drops /var/lib/domin/public-sync.request; domin-public-sync.service
# (root) then imports the newest copy of the public database. The web app never reads the copy itself.
[Unit]
Description=domin: watch for public database sync requests from Settings

[Path]
PathExists=/var/lib/domin/public-sync.request
Unit=domin-public-sync.service

[Install]
WantedBy=multi-user.target
